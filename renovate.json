{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": ["pnpm.catalog.*"],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": ["oxlint"],
      "allowedVersions": "<=1.72.0"
    },
    {
      "matchPackageNames": ["oxlint-tsgolint"],
      "allowedVersions": "<=0.22.1"
    }
  ]
}
